rules_version = '2';
// ============================================================================
// Firestore Security Rules — AgenteBacar
// ============================================================================
// IMPORTANTE: El Admin SDK (Service Account del agente y del backend) ignora
// estas reglas y siempre tiene acceso completo. Estas reglas solo afectan a
// clientes que usen Firebase Auth (el dashboard web, apps móvil, etc.).
//
// Para deployar:
//   firebase deploy --only firestore:rules
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Modelo del módulo independiente de etiquetas QR
    // =========================================================================
    // etiquetas_qr_admin/{token} (privado, solo usuarios autenticados):
    //   machineId: string (1..150), hostname: string (1..100),
    //   ubicacion: string (1..120), activa: bool,
    //   creadaEn: timestamp inmutable, actualizadaEn: timestamp.
    //
    // fichas_qr/{token} (lectura pública solo por ID, sin listado público):
    //   hostname: string (1..100), ubicacion: string (1..120),
    //   activa: bool, actualizadaEn: timestamp.
    // No contiene UUID, IP, usuario, software ni datos operativos del agente.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidEtiquetaAdmin(data) {
      let source = get(/databases/$(database)/documents/computadoras/$(data.machineId));
      return data.keys().hasAll([
          'machineId', 'hostname', 'ubicacion', 'activa',
          'creadaEn', 'actualizadaEn'
        ])
        && data.keys().hasOnly([
          'machineId', 'hostname', 'ubicacion', 'activa',
          'creadaEn', 'actualizadaEn'
        ])
        && data.machineId is string
        && data.machineId.size() >= 1
        && data.machineId.size() <= 150
        && data.hostname is string
        && data.hostname.size() >= 1
        && data.hostname.size() <= 100
        && data.ubicacion is string
        && data.ubicacion.size() >= 1
        && data.ubicacion.size() <= 120
        && data.activa is bool
        && data.creadaEn is timestamp
        && data.actualizadaEn is timestamp
        && source.data.hostname == data.hostname
        && source.data.ubicacion == data.ubicacion;
    }

    function isValidFichaPublica(data, token) {
      let admin = getAfter(
        /databases/$(database)/documents/etiquetas_qr_admin/$(token)
      );
      return data.keys().hasAll([
          'hostname', 'ubicacion', 'activa', 'actualizadaEn'
        ])
        && data.keys().hasOnly([
          'hostname', 'ubicacion', 'activa', 'actualizadaEn'
        ])
        && data.hostname is string
        && data.hostname.size() >= 1
        && data.hostname.size() <= 100
        && data.ubicacion is string
        && data.ubicacion.size() >= 1
        && data.ubicacion.size() <= 120
        && data.activa is bool
        && data.actualizadaEn is timestamp
        && admin.data.hostname == data.hostname
        && admin.data.ubicacion == data.ubicacion
        && admin.data.activa == data.activa;
    }

    // -------------------------------------------------------------------------
    // config/ — COMPLETAMENTE CERRADO al SDK cliente
    // -------------------------------------------------------------------------
    // Contiene config/agente_hw y config/agente con la URL de actualización.
    // Solo el Admin SDK (agente + backend) puede leer o escribir aquí.
    // Esto previene que cualquier usuario del dashboard (o atacante con token
    // válido) inyecte una URL maliciosa que desencadene una actualización falsa.
    match /config/{document} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // computadoras/ — lectura para dashboard, escritura solo Admin SDK
    // -------------------------------------------------------------------------
    // El agente escribe datos de hardware via Admin SDK (no afectado por reglas).
    // El dashboard puede leer para mostrar el estado de las PCs.
    // Ningún cliente puede escribir directamente datos de una máquina.
    match /computadoras/{machineId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Subcolección programas: mismos permisos que el documento padre.
      match /programas/{programaId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // tareas/ — el dashboard autenticado puede escribir comandos
    // -------------------------------------------------------------------------
    // El dashboard escribe comandos (ACTUALIZAR_AGENTE, ACTUALIZAR_DATOS, etc.).
    // El agente lee y actualiza el estado via Admin SDK.
    // Los clientes NO pueden leer tareas (contiene metadata interna de la PC).
    //
    // NOTA IMPORTANTE para el anti-replay:
    // El dashboard DEBE incluir el campo "fecha_comando: SERVER_TIMESTAMP"
    // al escribir ACTUALIZAR_AGENTE. El agente rechaza comandos con más de
    // 10 minutos de antigüedad (configurable en config/config.py).
    match /tareas/{machineId} {
      allow read: if false;
      allow write: if request.auth != null;
    }

    // -------------------------------------------------------------------------
    // logs_actualizaciones/ — lectura para dashboard, escritura solo Admin SDK
    // -------------------------------------------------------------------------
    match /logs_actualizaciones/{logId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // cyberwatch_logs/ — lectura para dashboard, escritura solo Admin SDK
    // -------------------------------------------------------------------------
    match /cyberwatch_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Etiquetas QR — administración autenticada y ficha mínima pública
    // -------------------------------------------------------------------------
    match /etiquetas_qr_admin/{token} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && isValidEtiquetaAdmin(request.resource.data)
        && request.resource.data.creadaEn == request.time
        && request.resource.data.actualizadaEn == request.time;
      allow update: if isAuthenticated()
        && isValidEtiquetaAdmin(request.resource.data)
        && request.resource.data.machineId == resource.data.machineId
        && request.resource.data.creadaEn == resource.data.creadaEn
        && request.resource.data.actualizadaEn == request.time;
      allow delete: if false;
    }

    match /fichas_qr/{token} {
      allow get: if resource.data.activa == true;
      allow list: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && isValidFichaPublica(request.resource.data, token)
        && request.resource.data.actualizadaEn == request.time;
      allow delete: if false;
    }
  }
}
